# ==============================================================================
# AI Dev Team - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env AND SET YOUR VALUES:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
# DO NOT COMMIT REAL API KEYS OR SECRETS TO VERSION CONTROL.
# ==============================================================================

# LLM Provider Configuration
# Supported providers: "gemini", "openai", "openai_compatible", "mock"
LLM_PROVIDER=gemini

# Google Gemini API Key (Keep secret, never commit!)
GEMINI_API_KEY=

# Default model name for LLM Agent operations (e.g. gemini-3.8-flash, gpt-4o-mini)
LLM_MODEL=gemini-3.8-flash

# OpenAI or Compatible API Key (Alternative)
# LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Model sampling temperature (0.0 to 1.0)
LLM_TEMPERATURE=0.2

# Maximum output tokens generated by the model
LLM_MAX_TOKENS=2048

# Request timeout in seconds
LLM_TIMEOUT=15.0

# If true and LLM is unconfigured or fails, fallback to deterministic Planner automatically
LLM_FALLBACK_TO_DETERMINISTIC=true

# Default planner mode if not explicitly specified per task ("deterministic" or "llm")
DEFAULT_PLANNER_MODE=deterministic

# Database Path (Optional, defaults to backend/ai_dev_team.db)
# AI_DEV_TEAM_DB_PATH=ai_dev_team.db

# Optional GitHub pull request delivery. Leave empty to keep local git delivery only.
# Do not commit a real token.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
# GITHUB_REPOSITORY=owner/repo
# GITHUB_API_BASE=https://api.github.com
# GITHUB_BASE_BRANCH=main
