# LLM Provider Configuration for AI Dev Team Backend
# Supported providers: "gemini", "openai", "openai_compatible", "mock"
LLM_PROVIDER=gemini

# Google Gemini Configuration (Verified official model: gemini-3.8-flash)
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash

# OpenAI / OpenAI-Compatible Configuration (Alternative)
# LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# LLM Runtime Settings
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=15.0
LLM_FALLBACK_TO_DETERMINISTIC=true
DEFAULT_PLANNER_MODE=deterministic

# Optional GitHub pull request delivery. Leave empty to keep local git delivery only.
# Do not commit a real token.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
# GITHUB_REPOSITORY=owner/repo
# GITHUB_API_BASE=https://api.github.com
# GITHUB_BASE_BRANCH=main

